{
  "name": "prakalp-labs-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Prakalp Labs - Professional Technology & Digital Product Engineering Platform",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "dev:all": "node -e \"console.log('Run frontend and backend in separate terminals: npm run dev:frontend and npm run dev:backend')\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "test": "npm run test --workspace=backend",
    "seed": "npm run seed --workspace=backend"
  },
  "keywords": [
    "prakalp-labs",
    "software-engineering",
    "technology-solutions",
    "mern-stack",
    "react",
    "express",
    "mongodb",
    "nodejs",
    "vite"
  ],
  "author": "Prakalp Labs Engineering Team",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-serve-static-core": "^4.19.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5"
  }
}
