# ==============================================================================
# Prakalp Labs Backend Environment Configuration
# ==============================================================================

# Server Port
PORT=5000

# Node Environment: 'development' | 'production' | 'test'
NODE_ENV=development

# MongoDB Connection String (Local instance or MongoDB Atlas cluster)
# Local example: mongodb://127.0.0.1:27017/prakalp_labs
# Atlas example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/prakalp_labs?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/prakalp_labs

# JWT Authentication Secret Key (Generate a secure random string for production)
JWT_SECRET=prakalp_labs_jwt_secret_dev_key_do_not_use_in_prod_9876
JWT_EXPIRES_IN=7d

# Allowed Frontend URL for CORS & Cookie Origin
FRONTEND_URL=http://localhost:3000

# Administrator Onboarding Key for /api/v1/auth/setup-admin
ADMIN_SETUP_SECRET=prakalp_admin_setup_key_2026
